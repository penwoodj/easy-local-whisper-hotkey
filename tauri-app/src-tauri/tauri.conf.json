{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Local Whisper Hotkey",
  "version": "0.1.0",
  "identifier": "com.jon.easy-local-whisper-hotkey",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Easy Local Whisper Hotkey",
        "width": 300,
        "height": 420,
        "minWidth": 280,
        "minHeight": 360,
        "maxWidth": 380,
        "maxHeight": 900,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
