[Unit]
Description=Whisper Ctrl+Space Dictation Daemon
After=pipewire.service pulseaudio.service docker.service default.target

[Service]
Type=simple
Environment=DISPLAY=:0.0
Environment=XAUTHORITY=%h/.Xauthority
EnvironmentFile=-%h/.config/whisper-hotkey/whisper-hotkey.env
ExecStartPre=/bin/sleep 5
ExecStart=%h/.local/bin/easy-local-whisper-hotkey run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
